# ---------------------------------------------------------------------------
# Usado pelo docker-compose.yml. Copie para ".env" antes de subir a stack:
#   cp .env.example .env
# ---------------------------------------------------------------------------

POSTGRES_USER=leadguardian
POSTGRES_PASSWORD=leadguardian
POSTGRES_DB=leadguardianai

# Gere um valor forte, por exemplo: openssl rand -base64 32
AUTH_SECRET=

# Deixe em branco para desenvolvimento local em HTTP simples. Defina como
# "https://seu-dominio.com" quando houver TLS na frente da aplicação — isso
# ativa o cookie de sessão "__Secure-" (ver apps/web/server.ts).
AUTH_URL=

# ---------------------------------------------------------------------------
# Usado apenas para rodar apps/web e apps/worker fora do Docker (pnpm dev).
# Cada app também aceita essas variáveis via seu próprio .env.local / .env.
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql://leadguardian:leadguardian@localhost:5432/leadguardianai
# REDIS_URL=redis://localhost:6379
