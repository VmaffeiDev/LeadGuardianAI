# ---------------------------------------------------------------------------
# Usado pelo docker-compose.yml. Copie para ".env" antes de subir a stack:
#   cp .env.example .env
# ---------------------------------------------------------------------------

POSTGRES_USER=leadguardian
POSTGRES_PASSWORD=leadguardian
POSTGRES_DB=leadguardianai

# Gere um valor forte, por exemplo: openssl rand -base64 32
AUTH_SECRET=

# Deixe em branco para desenvolvimento local em HTTP simples. Defina como
# "https://seu-dominio.com" quando houver TLS na frente da aplicação — isso
# ativa o cookie de sessão "__Secure-" (ver apps/web/server.ts).
AUTH_URL=

# ---------------------------------------------------------------------------
# Triagem automática via WhatsApp (opcional — só necessário se for usar a
# importação de leads em CSV). Requer Meta Cloud API + template de mensagem
# aprovado; ver README para o passo a passo.
# ---------------------------------------------------------------------------

# Token de acesso do WABA (WhatsApp Business Account), usado pelo worker para
# enviar mensagens.
WHATSAPP_ACCESS_TOKEN=

# Valor arbitrário que você escolhe e cola também no painel do Meta App ao
# configurar o webhook — confirma que o handshake de verificação é legítimo.
WHATSAPP_VERIFY_TOKEN=

# "App Secret" do Meta App (Configurações > Básico), usado para validar a
# assinatura de cada webhook recebido.
WHATSAPP_APP_SECRET=

# Chave da API da Anthropic, usada pelo worker para classificar a resposta do
# lead em quente/morno/frio.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Usado apenas para rodar apps/web e apps/worker fora do Docker (pnpm dev).
# Cada app também aceita essas variáveis via seu próprio .env.local / .env.
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql://leadguardian:leadguardian@localhost:5432/leadguardianai
# REDIS_URL=redis://localhost:6379
