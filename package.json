{
  "name": "leadguardianai",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @leadguardian/db exec prisma generate",
    "db:migrate": "pnpm --filter @leadguardian/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @leadguardian/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @leadguardian/db run seed",
    "db:studio": "pnpm --filter @leadguardian/db exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.4.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
